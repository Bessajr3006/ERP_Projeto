# Exemplo de configuração (desenvolvimento)

NODE_ENV=development
PORT=3020

# Banco (MariaDB/MySQL)
DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=bessa_erp
DB_USER=erp_app
DB_PASSWORD=CHANGE_ME

# Auth (mínimo 32 caracteres)
JWT_SECRET=CHANGE_ME_MIN_32_CHARS_LONG_SECRET_KEY
JWT_EXPIRES_IN=90d
SALT_ROUNDS=10

# Criptografia (64 chars hex: openssl rand -hex 32)
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS_0123456789abcdef0123456789abcdef0123456789ab

# Opcional: usado apenas para gerar tipos via kysely-codegen
# DATABASE_URL=mysql://root:CHANGE_ME@127.0.0.1:3308/bessa_erp
