# Exemplo de configuração (produção / docker compose)

NODE_ENV=production
PORT=3030
TZ=America/Sao_Paulo

# Conexão do backend com o banco
DB_HOST=db
DB_PORT=3306
DB_NAME=bessa_erp
DB_USER=erp_app
DB_PASSWORD=CHANGE_ME

# Bootstrap do container MariaDB
MARIADB_DATABASE=bessa_erp
MARIADB_USER=erp_app
MARIADB_PASSWORD=CHANGE_ME
MARIADB_ROOT_PASSWORD=CHANGE_ME

# Auth (mínimo 32 caracteres)
JWT_SECRET=CHANGE_ME_MIN_32_CHARS_LONG_SECRET_KEY

JWT_EXPIRES_IN=24h
SALT_ROUNDS=10

# Criptografia (64 chars hex: openssl rand -hex 32)
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS_0123456789abcdef0123456789abcdef0123456789ab

# Traefik / Portainer
TRAEFIK_CERTRESOLVER=myresolver
TRAEFIK_PUBLIC_NETWORK_NAME=traefik

# Volumes / rede
MARIADB_VOLUME_NAME=mariadb
APP_DATA_VOLUME_NAME=projeto_erp_bessa_app_data
ERP_INTERNAL_NETWORK_NAME=projeto_erp_bessa_internal

# phpMyAdmin
PHPMYADMIN_UPLOAD_LIMIT=256M
