# ── Stage 1: Build dos assets ──────────────────────────────────────────────────
FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c AS builder

WORKDIR /app

COPY package*.json ./
# Evita downloads pesados de binários C++ durante o build do frontend
RUN FFMPEG_STATIC_SKIP_DOWNLOAD=true PUPPETEER_SKIP_DOWNLOAD=true \
    NODE_OPTIONS="--max-old-space-size=512" \
    npm ci --no-audit --no-fund

COPY . .

# Atualiza versão de build
RUN npm run --silent bump:build-version

# Compila Tailwind CSS e TypeScript do frontend
RUN npm run build:css
RUN npm run build:public

# ── Stage 2: Nginx não-root servindo os arquivos estáticos ─────────────────────
FROM nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10

# Copia os arquivos estáticos compilados para o diretório raiz do Nginx
COPY --from=builder /app/public /usr/share/nginx/html

# Copia a configuração customizada do Nginx
COPY nginx/default.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ || exit 1
